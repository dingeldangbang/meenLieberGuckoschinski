{
  "name": "buchmaschine",
  "version": "1.0.0",
  "private": true,
  "description": "Buchmaschine - KDP-Studio fuer druckfertige Buecher: Nischen, Inhalte, PDF-Export und Monetarisierung",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "build:book": "node bin/buchmaschine.mjs build",
    "preflight": "node bin/buchmaschine.mjs preflight",
    "pipeline:harvest": "node scripts/harvest_keywords.mjs --out artifacts/metadata.json",
    "pipeline:build": "node scripts/build_package.mjs --config artifacts/metadata.json --out artifacts",
    "pipeline:gate": "node scripts/preflight_checker.mjs --all artifacts/manifest.json",
    "pipeline:deploy": "node scripts/deploy_digital.mjs --manifest artifacts/manifest.json",
    "pipeline:dry-run": "node scripts/deploy_digital.mjs --manifest artifacts/manifest.json --dry-run",
    "pipeline": "node scripts/harvest_keywords.mjs --out artifacts/metadata.json && node scripts/build_package.mjs --config artifacts/metadata.json --out artifacts && node scripts/preflight_checker.mjs --all artifacts/manifest.json",
    "pipeline:onix": "node scripts/onix.mjs --manifest artifacts/manifest.json --out artifacts/onix3.xml",
    "pipeline:dnb": "node scripts/legal_deposit.mjs --manifest artifacts/manifest.json --out artifacts/dnb"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "bin": {
    "buchmaschine": "bin/buchmaschine.mjs"
  }
}
